{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siteproxy-example",
  "pages_build_output_dir": "./build/cf_page",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "proxy_url": "https://example.invalid",
    "token_prefix": "/default/"
  }
}
